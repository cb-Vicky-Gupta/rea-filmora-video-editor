{
  "name": "rea-filmora-video-editor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.88.0",
    "prettier": "^3.9.10",
    "typescript": "~7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "description": "Open-source, browser-based video editor built with React, TypeScript and Vite",
  "license": "MIT",
  "author": "Vicky Gupta",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cb-Vicky-Gupta/rea-filmora-video-editor.git"
  },
  "bugs": {
    "url": "https://github.com/cb-Vicky-Gupta/rea-filmora-video-editor/issues"
  },
  "homepage": "https://github.com/cb-Vicky-Gupta/rea-filmora-video-editor#readme",
  "engines": {
    "node": ">=20.19"
  }
